{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://portfolio.local/contracts/job-match-result.schema.json",
  "title": "JobMatchResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["language", "strongMatches", "partialMatches", "missingEvidence", "followUpQuestions"],
  "properties": {
    "language": { "type": "string", "enum": ["he", "en"] },
    "strongMatches": { "type": "array", "items": { "$ref": "#/definitions/match" } },
    "partialMatches": { "type": "array", "items": { "$ref": "#/definitions/match" } },
    "missingEvidence": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "followUpQuestions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "definitions": {
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirement", "evidenceSourceIds", "explanation"],
      "properties": {
        "requirement": { "type": "string", "minLength": 1 },
        "evidenceSourceIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "explanation": { "type": "string", "minLength": 1 }
      }
    }
  }
}
